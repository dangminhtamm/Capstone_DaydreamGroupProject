{
  "name": "Capstone_DaydreamGroupProject",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "build": "pnpm --recursive --if-present run build",
    "test": "pnpm --recursive --if-present run test",
    "audit": "pnpm audit --prod --audit-level moderate",
    "demo:seed": "node --env-file=.env --experimental-strip-types packages/db/scripts/seed-demo.ts",
    "ci:memory-eval": "pnpm --filter @second-brain/ai eval:retrieval:ci && pnpm --filter @second-brain/ai eval:answer:ci"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.13",
      "@babel/core": "7.29.6",
      "fast-uri": "3.1.2",
      "form-data": "4.0.6",
      "postcss": "8.5.12",
      "qs": "6.15.3",
      "ws": "8.21.0"
    }
  }
}
