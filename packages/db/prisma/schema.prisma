// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector] // Enables pgvector extension
}

// schema.prisma

model CalendarEvent {
  id          String   @id @default(uuid())
  user_id     String
  external_id String // Google Calendar Event ID, unique per user
  title       String
  start_time  DateTime
  end_time    DateTime

  description String? @db.Text
  html_link   String?


  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  diary_entry DiaryEntry[]

  @@unique([user_id, external_id], map: "calendar_events_user_external_key")
  @@index([user_id, start_time], map: "calendar_events_user_start_time_idx")
  @@map("calendar_events")
}

model Summary {
  id           String   @id @default(uuid())
  user_id      String
  summary_type String // 'daily', 'weekly', 'monthly', 'yearly'
  period_start DateTime
  period_end   DateTime
  content      String   @db.Text

  created_at DateTime @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, summary_type, period_start, period_end], map: "summaries_user_type_period_key")
  @@index([user_id, period_start], map: "summaries_user_period_start_idx")
  @@map("summaries")
}

model EntityMention {
  id           String @id @default(uuid())
  chunk_id     String
  entity_type  String // e.g., 'person', 'project', 'goal', 'habit'
  entity_value String

  created_at DateTime @default(now())

  // Relations
  chunk MemoryChunk @relation(fields: [chunk_id], references: [id], onDelete: Cascade)

  @@map("entity_mentions")
}

model GmailMessage {
  id          String @id @default(uuid())
  user_id     String
  external_id String @unique // Gmail Message/Thread ID
  sender      String
  subject     String
  body        String @db.Text

  created_at DateTime @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("gmail_messages")
}

// Update your User model to include these relations
model User {
  id               String  @id @default(uuid())
  supabaseId       String  @unique @db.Uuid // Links to auth.users in Supabase
  email            String  @unique
  display_name     String?
  google_connected Boolean @default(false) // Tracks OAuth status

  // OAuth Tokens (Needed for your calendar/gmail sync jobs)
  google_access_token  String?
  google_refresh_token String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  diary_entries   DiaryEntry[]
  memory_chunks   MemoryChunk[]
  summaries       Summary[]
  calendar_events CalendarEvent[]
  gmail_messages  GmailMessage[]
  search_history  SearchHistory[]

  @@map("users")
}

model DiaryEntry {
  id         String   @id @default(uuid())
  user_id    String
  entry_date DateTime @default(now())
  raw_text   String   @db.Text
  status     String   @default("draft") // e.g., draft, published

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  attachments     Attachment[]
  calendar_events CalendarEvent[] // Linked events from your matching logic

  @@map("diary_entries")
}

model Attachment {
  id             String  @id @default(uuid())
  diary_entry_id String
  storage_path   String
  file_type      String
  extracted_text String? @db.Text

  created_at DateTime @default(now())

  // Relations
  diary_entry DiaryEntry @relation(fields: [diary_entry_id], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model SearchHistory {
  id               String   @id @default(uuid())
  user_id          String
  question         String   @db.Text
  answer           String   @db.Text
  confidence       String   // 'high', 'medium', 'low'
  sources_json     String?  @db.Text // Serialized citation array
  analytics_json   String?  @db.Text // Serialized analytics object
  response_language String  @default("en")
  token_count      Int      @default(0)

  created_at DateTime @default(now())
  expires_at DateTime // Cache TTL (e.g. created_at + 24h)

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)], map: "search_history_user_created_idx")
  @@index([user_id, question], map: "search_history_user_question_idx")
  @@map("search_history")
}

model MemoryChunk {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  sourceType String   @map("source_type") // e.g., 'diary', 'calendar', 'gmail', 'attachment'
  sourceId   String   @map("source_id") // ID of the original record
  chunkIndex Int      @map("chunk_index")
  chunkType  String   @default("general_note") @map("chunk_type")
  text       String   @db.Text
  evidence   String?  @db.Text
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity_mentions EntityMention[]

  @@index([userId, sourceType, sourceId], map: "memory_chunks_user_source_idx")
  @@index([userId, occurredAt], map: "memory_chunks_user_occurred_at_idx")
  @@unique([userId, sourceType, sourceId, chunkIndex], map: "memory_chunks_user_source_chunk_key")
  @@map("memory_chunks")
}
