{
  "name": "@second-brain/db",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.104.1",
    "pg": "^8.20.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "memory:insert-sample": "node --env-file=.env --experimental-strip-types scripts/insert-memory-chunks.ts",
    "memory:test-search": "node --env-file=.env --experimental-strip-types scripts/test-vector-search.ts",
    "memory:test-query": "node --env-file=.env --experimental-strip-types scripts/test-answer-memory.ts"
  },
  "devDependencies": {
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.7.0"
  }
}
